{
  "schemaVersion": 1,
  "id": "geostrata",
  "version": "${version}",
  "name": "GeoStrata",
  "description": "Data-driven geology and building materials for Fabric 1.20.1. Runs standalone and exposes compatibility hooks that modpacks can extend with terrain and content mods.",
  "authors": [
    "GeoStrata contributors"
  ],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.geostrata.GeoStrata"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.2"
  },
  "custom": {
    "geostrata_stage": "pre-alpha",
    "geostrata_compatibility_model": "standalone-core-plus-optional-integrations"
  }
}
