{
  "schemaVersion": 1,
  "id": "geostrata",
  "version": "${version}",
  "name": "GeoStrata",
  "description": "Data-driven geology and building materials. This artifact targets Fabric 1.20.1; shared mod logic is kept loader-neutral for future Forge and NeoForge adapters.",
  "authors": [
    "GeoStrata contributors"
  ],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.geostrata.platform.fabric.FabricGeoStrata"
    ]
  },
  "mixins": [
    "geostrata.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.2"
  },
  "custom": {
    "geostrata_stage": "pre-alpha",
    "geostrata_compatibility_model": "shared-core-plus-loader-adapters"
  }
}
